<Window x:Class="NotesClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes Client"
        Height="600"
        Width="900">

    <Grid Margin="20">

        <TabControl x:Name="MainTabControl">

            <!-- Notes tab. -->
            <TabItem Header="Notes"
                     x:Name="NotesTab">
                <ContentControl x:Name="NotesContentControl"/>
            </TabItem>

            <!-- Categories tab. -->
            <TabItem Header="Categories">
                <ContentControl x:Name="CategoriesContentControl"/>
            </TabItem>

            <!-- Admin tab. -->
            <TabItem x:Name="AdminTab"
                     Header="Admin">
                <ContentControl x:Name="AdminContentControl"/>
            </TabItem>

        </TabControl>

        <!-- Logs the user out. -->
        <Button x:Name="LogoutButton"
                Content="Logout"
                Width="80"
                Height="22"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Click="LogoutButton_Click"/>

    </Grid>

</Window>