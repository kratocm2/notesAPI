<UserControl x:Class="NotesClient.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Category name input and add button. -->
        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBox x:Name="CategoryNameTextBox"
                     Width="200"
                     Height="25"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>

            <Button Content="Add"
                    Width="80"
                    Click="AddCategoryButton_Click"/>

        </StackPanel>

        <!-- Displays the user's categories. -->
        <ListBox x:Name="CategoriesList"
                 Grid.Row="1"
                 DisplayMemberPath="Name"
                 SelectionChanged="CategoriesList_SelectionChanged"/>

        <!-- Category actions. -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,15,0,0">

            <Button Content="Rename"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="RenameCategoryButton_Click"/>

            <Button Content="Delete"
                    Width="100"
                    Click="DeleteCategoryButton_Click"/>

        </StackPanel>

    </Grid>

</UserControl>