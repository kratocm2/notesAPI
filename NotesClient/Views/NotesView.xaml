<UserControl x:Class="NotesClient.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search and filter controls. -->
        <StackPanel Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">

                <TextBox x:Name="SearchTextBox"
                         Width="200"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>

                <Button Content="Search"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="SearchButton_Click"/>

                <Button Content="Clear"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="ClearSearchButton_Click"/>

                <Button Content="Refresh"
                        Width="80"
                        Click="RefreshButton_Click"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,0">

                <TextBlock Text="Category"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <ComboBox x:Name="CategoryFilterComboBox"
                          Width="140"
                          DisplayMemberPath="Name"
                          SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>

                <TextBlock Text="Sort"
                           VerticalAlignment="Center"
                           Margin="15,0,5,0"/>

                <ComboBox x:Name="SortComboBox"
                          Width="130"
                          SelectedIndex="0"
                          SelectionChanged="SortComboBox_SelectionChanged">

                    <ComboBoxItem Content="Last changed"/>
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Oldest"/>
                    <ComboBoxItem Content="Title A-Z"/>
                    <ComboBoxItem Content="Title Z-A"/>

                </ComboBox>

            </StackPanel>

        </StackPanel>

        <!-- Displays the current page of notes. -->
        <ListBox x:Name="NotesList"
                 Grid.Row="1"
                 DisplayMemberPath="Title"
                 SelectionChanged="NotesList_SelectionChanged"/>

        <!-- Pagination controls. -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,15">

            <Button x:Name="PreviousPageButton"
                    Content="Previous"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="PreviousPageButton_Click"/>

            <TextBlock x:Name="PageInfoTextBlock"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Button x:Name="NextPageButton"
                    Content="Next"
                    Width="100"
                    Click="NextPageButton_Click"/>

        </StackPanel>

        <!-- Note editor. -->
        <StackPanel Grid.Row="3">

            <TextBlock Text="Title"/>

            <TextBox x:Name="TitleTextBox"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Category"
                       Margin="0,10,0,0"/>

            <ComboBox x:Name="CategoryComboBox"
                      Margin="0,5,0,10"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <TextBlock Text="Content"/>

            <TextBox x:Name="ContentTextBox"
                     Height="80"
                     Margin="0,5,0,10"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>

            <StackPanel Orientation="Horizontal">

                <Button Content="Save"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Delete"
                        Width="100"
                        Click="DeleteButton_Click"/>

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="80"
                        Margin="5,10,0,0"
                        Click="CancelButton_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>